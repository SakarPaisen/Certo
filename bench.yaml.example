# Copy to bench.yaml and edit. Run with: certo bench
#
# A benchmark compares "arms" on Certo's bundled tasks, each graded by
# hidden tests the agent never sees. See docs/guides/benchmark.md and
# docs/reference/bench-yaml.md.
#
# Models are named from the model files: models_list.yaml (the catalog) and
# models.yaml (your keys and the models you use), by their `name`.
# Credentials stay there; this file has none and can be committed. The
# benchmark never reads .env and never uses --auto-model ranking. A model
# with `activated: false` can't be used: set it to true first.

# Optional. Without them, each file is looked for in the folder where you
# run certo bench, then in ~/.config/certo/.
# models_file: ./models.yaml
# models_list_file: ./models_list.yaml

# `all`, or a list of task names (certo bench --list-tasks shows them).
tasks: all
# tasks: [wordle-score, page-ranges, token-bucket]

# Runs per task per arm. Results vary between runs of the same model, so
# more repeats give a fairer comparison (and cost more).
repeats: 3

arms:
  # strategy: single = one model, the normal Certo run, exactly what
  # `certo "<task>"` does.
  - name: qwen-local
    strategy: single
    model: qwen3-coder-local      # a model `name`

  - name: sonnet
    strategy: single
    model: claude-sonnet-5

  # strategy: escalate = start on the first model, move to the next only
  # when Certo's verdict shows it couldn't finish (like certo --escalate).
  # Leave out `models` for the ladder Certo builds from the ratings.
  - name: local-then-cloud
    strategy: escalate
    models: [qwen3-coder-local, claude-sonnet-5]

# Optional: a folder of your own tasks instead of the bundled set, in the
# same shape (task.md, starter/, hidden_tests/, reference/).
# tasks_dir: ./my-bench-tasks
