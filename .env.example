# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Certo reads, per variable: the environment, then ./.env, then the user
# settings file ~/.config/certo/.env (or $XDG_CONFIG_HOME/certo/.env),
# which `certo init` writes for all projects.

# --- The ONLY line you change to switch provider/model ---
CERTO_LLM_MODEL=anthropic/claude-sonnet-4-5-20250929
# CERTO_LLM_MODEL=openai/gpt-5.6-luna
# CERTO_LLM_MODEL=gemini/gemini-2.0-flash
# CERTO_LLM_MODEL=ollama/llama3                 # + set CERTO_LLM_BASE_URL below
# CERTO_LLM_MODEL=openhands/claude-sonnet-4-5-20250929   # OpenHands proxy
# NOTE: model ID strings change over time — verify current IDs against the
# provider + LiteLLM docs if one errors.

# Key for whichever provider CERTO_LLM_MODEL selects.
CERTO_LLM_API_KEY=
# Only for local/self-hosted models (e.g. http://localhost:11434). Leave blank otherwise.
# NOTE: python-dotenv does not strip a trailing "# comment" from a line whose
# value is otherwise blank — keep this line's value empty with no trailing text.
CERTO_LLM_BASE_URL=

# Provider-neutral reasoning effort, passed straight through to the SDK
# (LiteLLM translates it per-provider). Leave blank to use the SDK's own
# default ("high"); for ollama/ models blank means no reasoning, since most
# have no thinking mode. none or off sends no reasoning parameter at all.
# Common values: none | minimal | low | medium | high | xhigh | max — the
# SDK also accepts future provider-specific values.
CERTO_LLM_REASONING_EFFORT=

# How long one call to the model may take, in seconds, before it fails and
# is retried (blank = 300; 0 = no limit). Raise it for slow local models.
CERTO_LLM_TIMEOUT_SECONDS=

# --- Certo policy (ours, not the LLM's) ---
# Every variable below is CERTO_*. The pre-rename HARNESS_* names are still
# read for one release as a deprecated fallback (CERTO_* wins if both are
# set) — see docs/reference/configuration.md.
CERTO_WORKSPACE=.                       # working dir the agent operates in (ignored if --project is used)
CERTO_MAX_ITERATIONS=50                 # safety cap on the agent loop
CERTO_CONFIRM_MODE=never                # never | always (pause before each tool call)
CERTO_EXECUTION=local                   # local | docker

# --- Projects: one subfolder per generated project (see docs/reference/commands.md) ---
CERTO_PROJECTS_DIR=./projects           # root folder; --project NAME -> CERTO_PROJECTS_DIR/NAME

# --- Your own skills, loaded on top of the built-in catalog (see docs/guides/add-skills-and-tools.md) ---
CERTO_SKILLS_DIR=./skills
# Third-party skills managed by `certo-admin skills` (see
# docs/guides/add-skills-and-tools.md). The directory is gitignored; the lockfile holds
# provenance/enablement only (no skill content). Installed != enabled.
CERTO_THIRD_PARTY_SKILLS_DIR=./third_party_skills
CERTO_THIRD_PARTY_SKILLS_LOCK=./third_party_skills.lock.json

# --- Post-hoc test verification (see docs/concepts/how-verification-works.md) ---
# After the agent finishes, the harness itself re-runs the project's own
# checks (no LLM involved) rather than trusting the agent's self-report.
CERTO_VERIFY_TESTS=always               # always | never
CERTO_MAX_VERIFY_RETRIES=2              # how many fix-and-recheck cycles before giving up

# --- Shared, task-level wall-clock budget (see docs/concepts/safety.md) ---
# Spans the whole task — the initial run plus every verify/retry cycle —
# not just one SDK conversation.run() call.
CERTO_MAX_TASK_SECONDS=1800

# Opt-in: allow the agent to pause and ask a question instead of always
# pushing forward autonomously (only the CLI's --interactive prompts a real
# human at the terminal; setting this without a caller that answers has no
# useful effect — see docs/guides/interactive-mode.md).
CERTO_INTERACTIVE=no

# --- Deterministic auto model selection (see
# docs/guides/pick-models-automatically.md). Default (manual) is byte-for-byte today's single-model
# behavior — CERTO_LLM_MODEL/CERTO_LLM_API_KEY above are used exactly as they always
# have been. models.yaml (git-ignored like .env — see models.yaml.example
# for the template) is only ever read when this is "auto".
CERTO_MODEL_SELECTION=manual             # manual | auto
CERTO_MODELS_FILE=./models.yaml

# --- Opt-in per-run artifacts directory (see docs/guides/run-records-and-costs.md) ---
# Blank (the default) disables this entirely. When set, every task run
# writes metadata, the full message transcript, and token/cost metrics to
# <this dir>/<project-or-_unscoped>/<run-id>/ — a separate, sibling
# directory to CERTO_PROJECTS_DIR, not nested inside any one project.
# Git-ignored by this repo's own .gitignore if left at the suggested
# relative default.
CERTO_ARTIFACTS_DIR=

# Set to 1 to skip the note printed before the agent edits a folder that
# already has files (uncommitted git changes, or not a git repository).
CERTO_NO_WORKTREE_WARNING=

# The `certo` command keeps the last run's state in the project's .certo/
# folder, so `certo --resume` can continue it. Set to 0 to turn this off.
CERTO_SAVE_STATE=

# --- Only consulted when CERTO_EXECUTION=docker ---
CERTO_DOCKER_IMAGE=certo/agent-server:local  # built automatically on first use
CERTO_DOCKER_PLATFORM=                  # linux/amd64 | linux/arm64; blank = auto-detect from host

# --- Server-mode task registry persistence (see
# docs/guides/run-as-a-server.md). Only consulted by `certo-server`/`certo-admin`, not the
# `certo` CLI. Default ("memory", TTL=0) is byte-for-byte the pre-existing
# in-memory, unbounded, per-process behavior — every setting below is opt-in.
CERTO_TASK_STORE=memory                 # memory | redis | sqlite | mysql | postgres
CERTO_TASK_TTL_SECONDS=0                # seconds a completed/failed task record is kept; 0 = forever

# sqlite (needs the "store-sqlite" extra: uv pip install -e ".[store-sqlite]")
CERTO_TASK_STORE_SQLITE_PATH=./certo_tasks.db

# mysql (needs "store-mysql": uv pip install -e ".[store-mysql]")
CERTO_TASK_STORE_MYSQL_HOST=localhost
CERTO_TASK_STORE_MYSQL_PORT=3306
CERTO_TASK_STORE_MYSQL_USER=root
CERTO_TASK_STORE_MYSQL_PASSWORD=
CERTO_TASK_STORE_MYSQL_DATABASE=certo

# postgres (needs "store-postgres": uv pip install -e ".[store-postgres]")
CERTO_TASK_STORE_POSTGRES_HOST=localhost
CERTO_TASK_STORE_POSTGRES_PORT=5432
CERTO_TASK_STORE_POSTGRES_USER=postgres
CERTO_TASK_STORE_POSTGRES_PASSWORD=
CERTO_TASK_STORE_POSTGRES_DATABASE=certo

# redis (needs "store-redis": uv pip install -e ".[store-redis]") — uses
# Redis's own native per-key expiration for the TTL above, not a purge sweep.
CERTO_TASK_STORE_REDIS_HOST=localhost
CERTO_TASK_STORE_REDIS_PORT=6379
CERTO_TASK_STORE_REDIS_DB=0
CERTO_TASK_STORE_REDIS_PASSWORD=
CERTO_TASK_STORE_REDIS_USE_TLS=false
